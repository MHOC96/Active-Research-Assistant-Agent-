# =========================
# Groq Cloud
# =========================

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_QUERY_MAX_OUTPUT_TOKENS=256
GROQ_SYNTHESIS_MAX_OUTPUT_TOKENS=1024

# =========================
# Google Gemini
# =========================

GOOGLE_API_KEY=your_google_api_key_here
# Comma-separated fallback keys used when rate limits are hit (429 / quota).
GOOGLE_API_KEYS=key_one,key_two,key_three
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# =========================
# Citations
# =========================

# internal | apa7 | mla9 | chicago17 | ieee | harvard
CITATION_STYLE=mla9

# =========================
# Performance
# =========================

# Batch size for Gemini embedding API calls during ingestion
EMBEDDING_BATCH_SIZE=32

# Concurrent Gemini embedding batch requests
EMBEDDING_MAX_WORKERS=4

# Concurrent PDF downloads during discovery
IO_MAX_WORKERS=4

# Lighter PDF parsing (disable table structure extraction)
FAST_INGESTION=false

# =========================
# Storage
# =========================

PERSIST_DIRECTORY=./data/chroma_db
DOWNLOAD_CACHE_DIR=./data/downloads
SQLITE_SPARSE_DB=./data/sparse_index.db
METADATA_DB=./data/metadata.db
EXPORTS_DIR=./data/exports

# =========================
# Retrieval
# =========================

RRF_DENSE_WEIGHT=0.6
RRF_SPARSE_WEIGHT=0.4
RRF_K_CONSTANT=60
RRF_CANDIDATE_K=15
FINAL_TOP_K=3
MAX_SUBQUERIES=5
SYNTHESIS_MAX_PASSAGE_CHARS=2400
SKIP_QUERY_LLM_FOR_SIMPLE=true
QUERY_ANALYSIS_CACHE_SIZE=64

# =========================
# Reranking
# =========================

RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# =========================
# Sufficiency
# =========================

MIN_CANDIDATES=1
MIN_RERANK_SCORE=0.70
MIN_EXTERNAL_RELEVANCE_SCORE=0.35
MIN_INDEXED_TOPIC_SCORE=0.30

# =========================
# Chunking
# =========================

CHUNK_TARGET_TOKENS=700
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100
MIN_CHUNK_CHARACTERS=80

# =========================
# Active Discovery
# =========================

DISCOVERY_SOURCES=arxiv,openalex,semantic_scholar,web
DISCOVERY_PER_SOURCE_MAX=1
DISCOVERY_MAX_RESULTS=5
MAX_NEW_DOCUMENTS_PER_QUERY=3
MAX_DISCOVERY_ROUNDS=2
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# =========================
# Download Security
# =========================

MAX_PDF_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=30
ALLOWED_DOWNLOAD_DOMAINS=arxiv.org,export.arxiv.org

# =========================
# Index Versioning
# =========================

INDEX_VERSION=v1
EMBEDDING_VERSION=gemini-embedding-001-768
RERANKER_VERSION=ms-marco-MiniLM-L-12-v2

# =========================
# Retry
# =========================

MAX_RETRIES=3
